# development | test | production
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Enabled by default in development and test; disabled by default in production.
API_DOCS_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/dr_nareman_dev
ADMIN_SESSION_TTL_HOURS=168
# Required in production. Use a persistent absolute directory outside the application release.
UPLOAD_ROOT_DIR=./uploads
# One-time provisioning only. Supply these temporarily when running admin:provision.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
